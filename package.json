{
  "name": "lockfile-maintenance-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "lint": "oxlint src test scripts",
