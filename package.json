    "marked": "18.1.0",
    "sanitize-html": "2.18.0",
    "semver": "7.8.5",
    "smol-toml": "1.8.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@yarnpkg/cli-dist": "4.18.0",
    "pnpm": "12.4.2"
  },
  "engines": {
    "node": ">=24"
  }
}
