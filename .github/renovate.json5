{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests'],
  baseBranchPatterns: ['$default', 'v1'],
  timezone: 'Asia/Tokyo',
  schedule: ['* 9-17 * * *'],
  prHourlyLimit: 5,
  labels: ['dependencies'],
  // Lockfiles are maintained by lockfile-maintenance-action.
  lockFileMaintenance: { enabled: false },
  packageRules: [
    {
      matchBaseBranches: ['main'],
      matchManagers: ['github-actions'],
      matchDepTypes: ['action'],
      matchFileNames: [
        '.github/workflows/ci.yml',
        '.github/workflows/lockfile-maintenance.yml',
        '.github/workflows/maintenance.yml',
        '.github/workflows/actions-lock.yml',
      ],
      pinDigests: false,
    },
    {
      matchManagers: ['npm'],
      minimumReleaseAge: '3 days',
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'github actions',
      minimumReleaseAge: '3 days',
      minimumReleaseAgeBuffer: null,
    },
    {
      matchManagers: ['github-actions'],
      matchPackageNames: [
        'actions/checkout',
        'peter-evans/create-pull-request',
        'step-security/harden-runner',
      ],
      groupName: 'github actions with credential access',
      minimumReleaseAge: '7 days',
    },
    {
      matchManagers: ['github-actions'],
      matchPackageNames: ['ruby/setup-ruby'],
      groupName: null,
      minimumReleaseAge: '24 hours',
    },
    {
      matchBaseBranches: ['v1'],
      branchPrefixOld: 'renovate/v1-',
      dependencyDashboardApproval: true,
    },
  ],
}
